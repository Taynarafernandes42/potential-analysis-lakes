!-------------------------------------------------------------------------------
! Lake Schwerin - GLM v4 configuration
! Input data are expected in ./Data/Raw, model output is written to ./output
!-------------------------------------------------------------------------------

!-------------------------------------------------------------------------------
! general model setup
!-------------------------------------------------------------------------------
&glm_setup
   sim_name = 'Schweriner See Simulation'
   max_layers = 500
   min_layer_vol = 0.025
   min_layer_thick = 0.15
   max_layer_thick = 1.5
   !-- Light parameters
   Kw = 0.3
   !-- Mixing parameters
   coef_mix_conv = 0.2
   coef_wind_stir = 0.3
   coef_mix_shear = 0.2
   coef_mix_turb = 0.7
   coef_mix_KH = 0.3
   coef_mix_hyp = 0.8
   deep_mixing = .true.
/

&mixing
  surface_mixing = 1
  coef_mix_conv = 0.14462
  coef_wind_stir = 0.23
  coef_mix_shear = 0.2
  coef_mix_turb = 0.51
  coef_mix_KH = 0.3
  deep_mixing = 2
  coef_mix_hyp = 0.5
  diff = 0.
/

&morphometry
   lake_name = 'Schweriner See'
   latitude = 53.65
   longitude = 11.45
   bsn_len = 24000
   bsn_wid = 6000
   bsn_vals = 52
   !   H(m)  A(m2)
   H = 0.00, 1.00, 2.00, 3.00, 4.00, 5.00, 6.00, 7.00, 8.00, 9.00, 
       10.00, 11.00, 12.00, 13.00, 14.00, 15.00, 16.00, 17.00, 18.00, 19.00, 
       20.00, 21.00, 22.00, 23.00, 24.00, 25.00, 26.00, 27.00, 28.00, 29.00, 
       30.00, 31.00, 32.00, 33.00, 34.00, 35.00, 36.00, 37.00, 38.00, 39.00, 
       40.00, 41.00, 42.00, 43.00, 44.00, 45.00, 46.00, 47.00, 48.00, 49.00, 
       50.00, 51.00
   A = 1466, 3957, 6425, 12377, 20534, 28931, 38757, 51261, 70962, 94008, 
       130633, 179566, 240946, 330561, 463576, 619648, 789636, 949924, 1127322, 1331290, 
       1552350, 1817185, 2193608, 2637500, 3203271, 3913537, 4758301, 5649513, 6729042, 7826321, 
       9088265, 10333890, 11989347, 13923871, 15417892, 17071444, 19521892, 21466742, 23752623, 27456691, 
       30304038, 34441000, 36845186, 38649929, 41689336, 42979401, 44337542, 46624804, 52040229, 55916974, 
       59345913, 62313209
/

&time
   timefmt = 2
   start = '2016-04-18 00:00:00'
   stop  = '2021-03-31 00:00:00'
   dt = 3600
   timezone = 1.0
/

&output
   out_dir = './output'
   out_fn = 'output'
   nsave = 24
   csv_lake_fname = 'lake'
   csv_point_nlevs = 10
   csv_point_fname = 'WaterTemp'
   csv_point_at = 1, 5, 10, 15, 20, 25, 30, 35, 40, 45
   csv_point_nvars = 2
   csv_point_vars = 'temp', 'salt'
   csv_outlet_fname = 'outlet_timeseries.csv'
   csv_outlet_nvars = 6
   csv_outlet_vars  = 'flow', 'temp', 'salt', 'hbot', 'htop', 'flbc'
/

!-- Initial temperature profile from observations (2016-04-18)
&init_profiles
    lake_depth = 48.5
    num_depths = 12
    the_depths = 0.5, 5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0, 42.0, 45.0, 48.0
    the_temps  = 7.5, 7.5, 7.4, 6.4, 5.7, 5.6, 5.6, 5.5, 5.4, 5.4, 5.4, 5.4
    the_sals   = 0.01
/

&meteorology
   met_sw      = .true.
   lw_type     = 'LW_CC'
   rain_sw     = .false.
   atm_stab    = 0
   cloud_mode  = 4
   fetch_mode  = 0
   !-- Boundary-condition file
   subdaily    = .true.
   meteo_fl    = './Data/Raw/meteo_glm.csv'
   wind_factor = 0.74084
   sw_factor   = 1.0
   lw_factor   = 1
   at_factor   = 1.0
   rh_factor   = 1.0
   rain_factor = 1.0
   !-- Bulk transfer coefficients
   ce = 0.00156239
   ch = 0.00156239
   cd = 0.0013
/

&light
   light_mode = 0
   n_bands = 4
   light_extc = 1.0, 0.5, 2.0, 4.0
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Kw = 0.781546
/

&bird_model
  AP = 973
  Oz = 0.279
  WatVap = 1.1
  AOD500 = 0.033
  AOD380 = 0.038
  Albedo = 0.2
/

&inflow
   num_inflows    = 2
   names_of_strms = 'hp', 'river'
   subm_flag      = .true., .false.
   subm_elev      = 10.0, 0.0
   strm_hf_angle  = 80, 80
   strmbd_slope   = 0.5, 0.5
   strmbd_drag    = 0.016, 0.016
   inflow_factor  = 1, 1
   inflow_fl      = './Data/Raw/inflow_heatpump.csv', './Data/Raw/inflow1.csv'
   inflow_varnum  = 3
   inflow_vars    = 'flow', 'temp', 'salt'
   coef_inf_entrain = 0.0
/

&outflow
   num_outlet        = 2
   outlet_type       = 1, 1
   outl_elvs         = 25.0, 45.0
   bsn_len_outl      = 4347, 4347
   bsn_wid_outl      = 520, 520
   outflow_fl        = './Data/Raw/outflow_0.csv', './Data/Raw/outflow1.csv'
   outflow_factor    = 1, 1
/

&heat_pump
   heat_pump_switch = 1
   heat_pump_inflow_idx = 0
   heat_pump_outflow_idx = 0
   heat_pump_temp_change = -2.0
   !-- Physical constraints
   heat_pump_min_temp = 2.0          ! Min injection temp (C) - avoid freezing
   heat_pump_max_temp = 35.0         ! Max injection temp (C) - ecological limit
   heat_pump_max_delta_t = 8.0       ! Max |dT| (C)
   heat_pump_max_flow = 864000.0     ! Max flow (m3/day = 10 m3/s)
   heat_pump_min_withdraw_temp = 1   ! Min withdrawal temp (C)
   heat_pump_enforce_limits = .true. ! Enforce limits (clamp values)
/
